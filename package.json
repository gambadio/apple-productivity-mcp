{
  "name": "@gambadio/apple-productivity-mcp",
  "version": "3.0.0",
  "mcpName": "io.github.gambadio/apple-productivity-mcp",
  "description": "Local macOS MCP suite: Mail, Calendar, Reminders, Notes, Contacts, iWork, files, Safari, media, and Shortcuts.",
  "main": "src/index.js",
  "bin": {
    "apple-productivity-mcp": "src/index.js"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "server.json",
    "docs",
    "manifest.json",
    "glama.json",
    "CHANGELOG.md"
  ],
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "node --test",
    "start": "node src/index.js",
    "test:integration": "RUN_APPLE_INTEGRATION=1 node --test test/integration.test.js",
    "docs:tools": "node scripts/generate-tool-docs.mjs",
    "test:personal-integration": "RUN_APPLE_PERSONAL_INTEGRATION=1 node --test test/personal-integration.test.js",
    "bundle": "node scripts/build-mcpb.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "macos",
    "apple-mail",
    "apple-calendar",
    "apple-reminders",
    "claude-code",
    "codex",
    "apple-notes",
    "apple-contacts",
    "pages",
    "numbers",
    "keynote",
    "safari",
    "photos",
    "music",
    "messages",
    "shortcuts",
    "finder",
    "icloud",
    "apple-productivity"
  ],
  "author": "Ricky",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gambadio/apple-productivity-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/gambadio/apple-productivity-mcp/issues"
  },
  "homepage": "https://github.com/gambadio/apple-productivity-mcp#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin"
  ],
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "^4.4.3"
  }
}
